## Deployment Configuration

### AWS CDK Infrastructure
```typescript
// infrastructure/governance-stack.ts
export class GovernanceStack extends Stack {
  constructor(scope: Construct, id: string, props: StackProps) {
    super(scope, id, props);

    // DynamoDB Table
    const governanceTable = new Table(this, 'GovernanceTable', {
      tableName: 'governance-data',
      partitionKey: { name: 'PK', type: AttributeType.STRING },
      sortKey: { name: 'SK', type: AttributeType.STRING },
      billingMode: BillingMode.PAY_PER_REQUEST,
      pointInTimeRecovery: true,
      stream: StreamViewType.NEW_AND_OLD_IMAGES,
    });

    // Add Global Secondary Indexes
    governanceTable.addGlobalSecondaryIndex({
      indexName: 'GSI1',
      partitionKey: { name: 'GSI1PK', type: AttributeType.STRING },
      sortKey: { name: 'GSI1SK', type: AttributeType.STRING },
    });

    // API Gateway
    const api = new RestApi(this, 'GovernanceAPI', {
      restApiName: 'governance-platform-api',
      description: 'Cardano Governance Platform API',
      defaultCorsPreflightOptions: {
        allowOrigins: Cors.ALL_ORIGINS,
        allowMethods: Cors.ALL_METHODS,
        allowHeaders: ['Content-Type', 'Authorization'],
      },
    });

    // Lambda Functions
    const proposalsHandler = new NodejsFunction(this, 'ProposalsHandler', {
      entry: 'src/handlers/proposals/index.ts',
      runtime: Runtime.NODEJS_22_X,
      architecture: Architecture.ARM_64,
      timeout: Duration.seconds(30),
      memorySize: 1024,
      environment: {
        GOVERNANCE_TABLE_NAME: governanceTable.tableName,
        CARDANO_NODE_ENDPOINT: process.env.CARDANO_NODE_ENDPOINT!,
      },
    });

    // Grant permissions
    governanceTable.grantReadWriteData(proposalsHandler);

    // API Routes
    const proposals = api.root.addResource('proposals');
    proposals.addMethod('GET', new LambdaIntegration(proposalsHandler));
    proposals.addMethod('POST', new LambdaIntegration(proposalsHandler));

    // WebSocket API
    const webSocketApi = new WebSocketApi(this, 'GovernanceWebSocket', {
      apiName: 'governance-websocket',
      description: 'Real-time governance updates',
    });
  }
}
```

