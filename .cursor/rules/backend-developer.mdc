  describe('/api/v1/proposals', () => {
    it('should return proposals list', async () => {
      const response = await request(app)
        .get('/api/v1/proposals')
        .expect(200);

      expect(response.body.proposals).toBeDefined();
      expect(Array.isArray(response.body.proposals)).toBe(true);
    });

    it('should require authentication for voting', async () => {
      await request(app)
        .post('/api/v1/proposals/test-proposal-id/vote')
        .send({ vote: 'yes' })
        .expect(401);
    });

    it('should accept valid vote with authentication', async () => {
      const authToken = await getValidAuthToken();
      
      const response = await request(app)
        .post('/api/v1/proposals/test-proposal-id/vote')
        .set('Authorization', `Bearer ${authToken}`)
        .send({
          vote: 'yes',
          rationale: 'Test vote',
          signature: 'valid-signature',
          txHash: 'valid-tx-hash'
        })
        .expect(200);

      expect(response.body.voteId).toBeDefined();
    });
  });
});
