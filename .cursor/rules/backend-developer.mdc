// src/middleware/security.ts
export const securityMiddleware = (): MiddyMiddleware => ({
  before: async (request) => {
    // Rate limiting
    await checkRateLimit(request.event.requestContext.identity.sourceIp);
    
    // Input validation
    validateRequestHeaders(request.event.headers);
    
    // CORS handling
    if (request.event.httpMethod === 'OPTIONS') {
      return {
        statusCode: 200,
        headers: getCorsHeaders(),
        body: ''
      };
    }
  },
  after: async (request) => {
    // Add security headers
    request.response.headers = {
      ...request.response.headers,
      ...getSecurityHeaders()
    };
  },
  onError: async (request) => {
    // Log security errors
    logger.error('Security middleware error', {
      error: request.error,
      event: request.event
    });
  }
});
