## Testing Requirements

### Unit Testing
```typescript
// src/tests/services/ProposalService.test.ts
describe('ProposalService', () => {
  let proposalService: ProposalService;
  let mockDb: jest.Mocked<GovernanceDatabase>;

  beforeEach(() => {
    mockDb = createMockDatabase();
    proposalService = new ProposalService(mockDb);
  });

  describe('listProposals', () => {
    it('should return paginated proposals', async () => {
      const mockProposals = createMockProposals(10);
      mockDb.query.mockResolvedValue(mockProposals);

      const result = await proposalService.listProposals({
        limit: 10,
        status: 'active'
      });

      expect(result.proposals).toHaveLength(10);
      expect(result.hasMore).toBe(false);
    });

    it('should filter proposals by status', async () => {
      const activeProposals = createMockProposals(5, { status: 'active' });
      mockDb.query.mockResolvedValue(activeProposals);

      const result = await proposalService.listProposals({
        status: 'active'
      });

      expect(result.proposals.every(p => p.status === 'active')).toBe(true);
    });
  });

  describe('submitVote', () => {
    it('should prevent double voting', async () => {
      mockDb.getVote.mockResolvedValue(createMockVote());

      await expect(proposalService.submitVote(
        createMockVoteRequest(),
        createMockUser()
      )).rejects.toThrow('User has already voted on this proposal');
    });

    it('should verify blockchain transaction', async () => {
      const mockVoteRequest = createMockVoteRequest();
      mockDb.getVote.mockResolvedValue(null);
      
      await proposalService.submitVote(mockVoteRequest, createMockUser());

      expect(mockBlockchainService.verifyTransaction)
        .toHaveBeenCalledWith(mockVoteRequest.txHash);
    });
  });
});
