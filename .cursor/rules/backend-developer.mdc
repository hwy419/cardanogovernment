## Database Design (DynamoDB Single-Table Pattern)

### Primary Table Schema
```typescript
interface GovernanceTable {
  PK: string;          // Partition Key
  SK: string;          // Sort Key
  GSI1PK?: string;     // Global Secondary Index 1 PK
  GSI1SK?: string;     // Global Secondary Index 1 SK
  GSI2PK?: string;     // Global Secondary Index 2 PK
  GSI2SK?: string;     // Global Secondary Index 2 SK
  EntityType: string;  // USER | DREP | PROPOSAL | VOTE | DELEGATION
  Data: Record<string, any>; // Entity-specific data
  TTL?: number;        // Time to live for temporary data
  CreatedAt: string;   // ISO timestamp
  UpdatedAt: string;   // ISO timestamp
}

// Access Patterns
interface AccessPatterns {
  // User Management
  'USER#<address>': 'PROFILE';
  'USER#<address>': 'VOTES#<timestamp>';
  'USER#<address>': 'DELEGATIONS#<timestamp>';
  
  // DRep Management
  'DREP#<drepId>': 'PROFILE';
  'DREP#<drepId>': 'DELEGATORS#<timestamp>';
  'DREP#<drepId>': 'PERFORMANCE#<epoch>';
  
  // Proposals
  'PROPOSAL#<proposalId>': 'METADATA';
  'PROPOSAL#<proposalId>': 'VOTES#<timestamp>';
  'PROPOSAL#<proposalId>': 'TIMELINE#<event>';
  
  // Global Queries (GSI)
  'STATUS#ACTIVE': 'PROPOSAL#<timestamp>';
  'TYPE#PARAMETER_CHANGE': 'PROPOSAL#<timestamp>';
  'VOTING_POWER#<amount>': 'DREP#<performance>';
}
```

### DynamoDB Data Models
```typescript
// User Entity
interface UserEntity extends GovernanceTable {
  PK: `USER#${string}`;           // USER#addr1...
  SK: 'PROFILE';
  EntityType: 'USER';
  Data: {
    address: string;
    publicKey: string;
    roles: string[];
    profile: {
      name: string;
      bio: string;
      avatar: string;
      website: string;
      social: Record<string, string>;
    };
    isActive: boolean;
    totalStake: number;
    lastActiveAt: string;
  };
}

// DRep Entity
interface DRepEntity extends GovernanceTable {
  PK: `DREP#${string}`;           // DREP#drep1...
  SK: 'PROFILE';
  GSI1PK: `STATUS#${string}`;     // For filtering by status
  GSI1SK: `PERFORMANCE#${number}`; // For sorting by performance
  EntityType: 'DREP';
  Data: {
    address: string;
    registrationTxHash: string;
    registrationDate: string;
    status: 'active' | 'inactive' | 'retired';
    votingPower: number;
    delegatorCount: number;
    metadata: {
      manifesto: string;
      experience: string;
      focusAreas: string[];
      votingPhilosophy: string;
    };
    performance: {
      totalVotes: number;
      participationRate: number;
      avgResponseTime: number;
      reputation: number;
    };
  };
}

// Governance Proposal Entity
interface ProposalEntity extends GovernanceTable {
  PK: `PROPOSAL#${string}`;       // PROPOSAL#prop1...
  SK: 'METADATA';
  GSI1PK: `STATUS#${string}`;     // For filtering by status
  GSI1SK: `TYPE#${string}#${string}`; // For filtering by type and date
  GSI2PK: `PROPOSER#${string}`;   // For user's proposals
  GSI2SK: `DATE#${string}`;       // For sorting by date
  EntityType: 'PROPOSAL';
  Data: {
    proposerId: string;
    type: 'parameter-change' | 'hard-fork' | 'treasury-withdrawal' | 'constitutional-change';
    title: string;
    description: string;
    rationale: string;
    submissionTxHash: string;
    submissionDate: string;
    votingStartDate: string;
    votingEndDate: string;
    status: 'pending' | 'active' | 'expired' | 'ratified' | 'rejected';
    metadata: Record<string, any>;
    votes: {
      drep: { yes: number; no: number; abstain: number };
      spo: { yes: number; no: number; abstain: number };
      constitutionalCouncil: { yes: number; no: number; abstain: number };
    };
    thresholds: {
      drepThreshold: number;
      spoThreshold: number;
      ccThreshold: number;
    };
    outcome?: string;
    finalizedAt?: string;
  };
}

// Vote Entity
interface VoteEntity extends GovernanceTable {
  PK: `PROPOSAL#${string}`;       // PROPOSAL#prop1...
  SK: `VOTE#${string}#${string}`; // VOTE#voterId#timestamp
  GSI1PK: `VOTER#${string}`;      // For user's voting history
  GSI1SK: `DATE#${string}`;       // For sorting by date
  EntityType: 'VOTE';
  Data: {
    proposalId: string;
    voterId: string;
    voterType: 'drep' | 'spo' | 'constitutional-council';
    vote: 'yes' | 'no' | 'abstain';
    votingPower: number;
    txHash: string;
    timestamp: string;
    rationale?: string;
    blockHeight: number;
    epochNumber: number;
  };
}
