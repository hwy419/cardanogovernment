### Authentication & Security

#### Wallet-Based Authentication
```typescript
// src/middleware/auth.ts
export const authenticateUser = async (authHeader?: string): Promise<AuthContext> => {
  if (!authHeader?.startsWith('Bearer ')) {
    throw new UnauthorizedError('Missing or invalid authorization header');
  }

  const token = authHeader.substring(7);
  const payload = await verifyJWT(token);
  
  // Verify wallet signature is still valid
  const isValidSignature = await verifyWalletSignature(
    payload.address,
    payload.publicKey,
    payload.signature,
    payload.message
  );

  if (!isValidSignature) {
    throw new UnauthorizedError('Invalid wallet signature');
  }

  return {
    userId: payload.sub,
    walletAddress: payload.address,
    roles: payload.roles,
    isAuthenticated: true
  };
};

// Wallet signature verification
export const verifyWalletSignature = async (
  address: string,
  publicKey: string,
  signature: string,
  message: string
): Promise<boolean> => {
  try {
    // Use Cardano crypto libraries to verify signature
    const isValid = await CardanoCrypto.verifySignature({
      address,
      publicKey,
      signature,
      message
    });
    
    return isValid;
  } catch (error) {
    logger.error('Signature verification failed', { error, address });
    return false;
  }
};
```

