const proposalsList: APIGatewayProxyHandler = async (event) => {
  try {
    const query = validateRequest(event.queryStringParameters, ProposalListRequestSchema);
    const user = await authenticateUser(event.headers.authorization);
    
    const proposalService = new ProposalService();
    const result = await proposalService.listProposals(query, user);
    
    return {
      statusCode: 200,
      body: JSON.stringify(result),
      headers: {
        'Content-Type': 'application/json',
        'Cache-Control': 'public, max-age=60', // 1 minute cache
      },
    };
  } catch (error) {
    return handleError(error);
  }
};

export const handler = middyfy(proposalsList);
