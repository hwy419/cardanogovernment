  <Label htmlFor="proposal-title" className="text-sm font-medium">
    Proposal Title *
  </Label>
  <Input
    id="proposal-title"
    {...register('title', { required: 'Title is required' })}
    aria-invalid={errors.title ? 'true' : 'false'}
    aria-describedby={errors.title ? 'title-error' : 'title-help'}
  />
  {errors.title && (
    <div id="title-error" className="text-sm text-red-600" role="alert">
      {errors.title.message}
    </div>
  )}
  <div id="title-help" className="text-sm text-gray-500">
    Enter a clear, descriptive title for your proposal
  </div>
</div>
```

## Real-time Features Implementation

### WebSocket Integration
```typescript
// useGovernanceUpdates.ts
export function useGovernanceUpdates() {
  const [socket, setSocket] = useState<WebSocket | null>(null);
  const queryClient = useQueryClient();

  useEffect(() => {
    const ws = new WebSocket(process.env.NEXT_PUBLIC_WS_URL!);
    
    ws.onmessage = (event) => {
      const data = JSON.parse(event.data);
      
      switch (data.type) {
        case 'PROPOSAL_UPDATE':
          queryClient.invalidateQueries(['proposals', data.proposalId]);
          break;
        case 'VOTE_CAST':
          queryClient.invalidateQueries(['proposal-votes', data.proposalId]);
          break;
        case 'DELEGATION_UPDATE':
          queryClient.invalidateQueries(['drep-delegations']);
          break;
      }
    };

    setSocket(ws);
    return () => ws.close();
  }, []);

  return socket;
}
```

### Optimistic Updates
```typescript
// useVoteSubmission.ts
export function useVoteSubmission() {
  const queryClient = useQueryClient();
  
  return useMutation({
    mutationFn: async (voteData: VoteSubmission) => {
      // Optimistic update
      queryClient.setQueryData(['user-votes'], (old: Vote[]) => [
        ...old,
        { ...voteData, status: 'pending' }
      ]);
      
      // Submit to blockchain
      return await submitVote(voteData);
    },
    onError: () => {
      // Revert optimistic update
      queryClient.invalidateQueries(['user-votes']);
    },
    onSuccess: (result) => {
      // Update with confirmed transaction
      queryClient.setQueryData(['user-votes'], (old: Vote[]) =>
        old.map(vote => 
          vote.id === result.id 
            ? { ...vote, txHash: result.txHash, status: 'confirmed' }
            : vote
        )
      );
    }
  });
}
```

