  describe('Voting Power Calculations', () => {
    it('should calculate DRep voting power correctly', async () => {
      const testDRep = await createTestDRep();
      await addTestDelegations(testDRep.id, 1000000); // 1M ADA
      
      const votingPower = await votingCalculator.calculateDRepVotingPower(testDRep.id);
      
      expect(votingPower.absolutePower).toBe(BigInt(1000000000000)); // 1M ADA in lovelace
      expect(votingPower.relativePower).toBeGreaterThan(0);
    });

    it('should handle voting power changes over epochs', async () => {
      const testDRep = await createTestDRep();
      const currentEpoch = await getCurrentEpoch();
      
      // Add delegation in current epoch
      await addTestDelegations(testDRep.id, 500000);
      const currentPower = await votingCalculator.calculateDRepVotingPower(
        testDRep.id, 
        currentEpoch
      );
      
      // Add more delegation in next epoch
      await simulateEpochTransition();
      await addTestDelegations(testDRep.id, 500000);
      const nextPower = await votingCalculator.calculateDRepVotingPower(
        testDRep.id, 
        currentEpoch + 1
      );
      
      expect(nextPower.absolutePower).toBeGreaterThan(currentPower.absolutePower);
    });
  });

  describe('Data Consistency', () => {
    it('should maintain consistency across data sources', async () => {
      const testAction = await createTestGovernanceAction();
      
      // Wait for all data sources to sync
      await waitForDataSourceSync(testAction.txHash);
      
      // Validate consistency across sources
      const validation = await governanceMonitor.validateDataConsistency(testAction.id);
      expect(validation.isConsistent).toBe(true);
    });

    it('should handle temporary data source failures', async () => {
      // Simulate Blockfrost API failure
      await simulateBlockfrostFailure();
      
      // Service should continue using other sources
      const actions = await governanceMonitor.getRecentGovernanceActions();
      expect(actions.length).toBeGreaterThan(0);
      
      // Restore service
      await restoreBlockfrostService();
    });
  });
});
