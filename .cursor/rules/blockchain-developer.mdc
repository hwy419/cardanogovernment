### Transaction Builder Service
```typescript
// Governance transaction building and submission
export class GovernanceTransactionBuilder {
  private lucid: Lucid;
  private meshTxBuilder: MeshTxBuilder;

  constructor(network: 'mainnet' | 'testnet' | 'preview') {
    this.lucid = await Lucid.new(
      new Blockfrost(
        `https://cardano-${network}.blockfrost.io/api/v0`,
        process.env.BLOCKFROST_PROJECT_ID!
      ),
      network
    );
    
    this.meshTxBuilder = new MeshTxBuilder({
      fetcher: new BlockfrostProvider(process.env.BLOCKFROST_PROJECT_ID!),
      evaluator: new MeshCSL()
    });
  }

  async buildGovernanceActionTx(
    proposer: Address,
    actionType: GovernanceActionType,
    actionDetails: GovernanceActionDetails,
    metadata?: GovernanceMetadata
  ): Promise<Transaction> {
    const tx = this.lucid.newTx();

    // Add governance action certificate
    const govActionCert = this.createGovernanceActionCertificate(
      actionType,
      actionDetails,
      metadata
    );
    
    tx.attachCertificate(govActionCert);

    // Calculate and add required deposit
    const deposit = await this.calculateGovernanceDeposit(actionType);
    tx.payToAddress(await this.getGovernanceDepositAddress(), {
      lovelace: deposit.toString()
    });

    // Add metadata if provided
    if (metadata) {
      tx.attachMetadata(721, metadata);
    }

    // Build transaction
    const unsignedTx = await tx.complete();
    return unsignedTx;
  }

  async buildVoteTx(
    voter: VoterCredential,
    governanceActionId: GovernanceActionId,
    vote: 'yes' | 'no' | 'abstain',
    rationale?: string
  ): Promise<Transaction> {
    const tx = this.lucid.newTx();

    // Create vote certificate
    const voteCert = this.createVoteCertificate(
      voter,
      governanceActionId,
      vote,
      rationale
    );
    
    tx.attachCertificate(voteCert);

    // Add rationale metadata if provided
    if (rationale) {
      const rationaleMetadata = this.createRationaleMetadata(rationale);
      tx.attachMetadata(674, rationaleMetadata); // CIP-100 governance metadata
    }

    const unsignedTx = await tx.complete();
    return unsignedTx;
  }

  async buildDRepRegistrationTx(
    drepCredential: Credential,
    metadata: DRepMetadata
  ): Promise<Transaction> {
    const tx = this.lucid.newTx();

    // Create DRep registration certificate
    const drepCert = this.createDRepRegistrationCertificate(
      drepCredential,
      metadata
    );
    
    tx.attachCertificate(drepCert);

    // Add required deposit
    const deposit = await this.getDRepDeposit();
    tx.payToAddress(await this.getDRepDepositAddress(), {
      lovelace: deposit.toString()
    });

    // Add DRep metadata
    tx.attachMetadata(721, this.formatDRepMetadata(metadata));

    const unsignedTx = await tx.complete();
    return unsignedTx;
  }

  async buildDelegationTx(
    stakeCredential: Credential,
    drepId: DRepId,
    poolId?: PoolId
  ): Promise<Transaction> {
    const tx = this.lucid.newTx();

    // Create delegation certificate
    const delegationCert = this.createDelegationCertificate(
      stakeCredential,
      drepId,
      poolId
    );
    
    tx.attachCertificate(delegationCert);

    const unsignedTx = await tx.complete();
    return unsignedTx;
  }

  private createGovernanceActionCertificate(
    actionType: GovernanceActionType,
    actionDetails: GovernanceActionDetails,
    metadata?: GovernanceMetadata
  ): Certificate {
    // Implement CIP-1694 governance action certificate creation
    // Handle different action types with appropriate validation
    // Include anchor for metadata if provided
  }

  private async calculateGovernanceDeposit(actionType: GovernanceActionType): Promise<bigint> {
    // Query current protocol parameters for governance deposits
    const protocolParams = await this.lucid.provider.getProtocolParameters();
    
    switch (actionType) {
      case 'parameter_change':
        return protocolParams.govActionDeposit;
