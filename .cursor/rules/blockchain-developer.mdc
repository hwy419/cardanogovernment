interface GovernanceAction {
  actionId: {
    transactionId: string;
    governanceActionIndex: number;
  };
  proposalProcedure: {
    deposit: string; // ADA amount in lovelace
    rewardAccount: string;
    anchor?: {
      url: string;
      dataHash: string;
    };
  };
  actionType: GovernanceActionType;
  actionDetails: GovernanceActionDetails;
  votingProcedure: {
    drepVotes: Map<DRepId, Vote>;
    spoVotes: Map<PoolId, Vote>;
    constitutionalCommitteeVotes: Map<CommitteeMemberId, Vote>;
  };
  ratificationState: 'pending' | 'ratified' | 'expired' | 'dropped';
  enactmentState: 'pending' | 'enacted' | 'failed';
}

// DRep Registration Certificate
interface DRepCertificate {
  drepCredential: Credential;
  deposit: string; // ADA in lovelace
  anchor?: {
    url: string;
    dataHash: string;
  };
  certificateType: 'registration' | 'deregistration' | 'update';
}

// Vote Certificate
interface VoteCertificate {
  voter: {
    type: 'drep' | 'spo' | 'constitutional_committee';
    id: string;
  };
  governanceActionId: {
    transactionId: string;
    governanceActionIndex: number;
  };
  vote: 'yes' | 'no' | 'abstain';
  anchor?: {
    url: string;
    dataHash: string;
  };
}

// Delegation Certificate
interface DelegationCertificate {
  stakingCredential: Credential;
  delegationType: 'stake_pool' | 'drep' | 'stake_pool_and_drep';
  poolId?: PoolId;
  drepId?: DRepId;
}
