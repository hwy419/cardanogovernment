### Voting Power Calculator
```typescript
// Calculate voting power for different voter types
export class VotingPowerCalculator {
  private dbSyncPool: Pool;
  private protocolParams: ProtocolParameters;

  constructor() {
    this.dbSyncPool = new Pool({
      connectionString: process.env.CARDANO_DB_SYNC_URL!
    });
  }

  async calculateDRepVotingPower(
    drepId: DRepId,
    atEpoch?: number
  ): Promise<VotingPower> {
    const epoch = atEpoch || await this.getCurrentEpoch();
    
    // Query total delegated stake to this DRep
    const delegatedStake = await this.queryDelegatedStake(drepId, epoch);
    
    // Get DRep's own stake if they have any
    const ownStake = await this.queryDRepOwnStake(drepId, epoch);
    
    const totalVotingPower = delegatedStake + ownStake;
    
    // Calculate relative voting power as percentage of total active stake
    const totalActiveStake = await this.getTotalActiveStake(epoch);
    const relativeVotingPower = (totalVotingPower / totalActiveStake) * 100;

    return {
      absolutePower: totalVotingPower,
      relativePower: relativeVotingPower,
      delegatorCount: await this.getDelegatorCount(drepId, epoch),
      epoch,
      calculatedAt: new Date().toISOString()
    };
  }

  async calculateSPOVotingPower(
    poolId: PoolId,
    atEpoch?: number  
  ): Promise<VotingPower> {
    const epoch = atEpoch || await this.getCurrentEpoch();
    
    // Query stake pool total stake
    const poolStake = await this.queryPoolStake(poolId, epoch);
    
    // Calculate relative voting power
    const totalActiveStake = await this.getTotalActiveStake(epoch);
    const relativeVotingPower = (poolStake / totalActiveStake) * 100;

    return {
      absolutePower: poolStake,
      relativePower: relativeVotingPower,
      delegatorCount: await this.getPoolDelegatorCount(poolId, epoch),
      epoch,
      calculatedAt: new Date().toISOString()
    };
  }

  async calculateUserVotingPower(
    address: Address,
    voteType: 'drep' | 'spo',
    atEpoch?: number
  ): Promise<VotingPower> {
    const epoch = atEpoch || await this.getCurrentEpoch();
    
    if (voteType === 'drep') {
      // Calculate as DRep
      const drepId = await this.getDRepIdFromAddress(address);
      if (!drepId) {
        throw new Error('Address is not registered as DRep');
      }
      return this.calculateDRepVotingPower(drepId, epoch);
    } else {
      // Calculate as SPO
      const poolId = await this.getPoolIdFromAddress(address);
      if (!poolId) {
        throw new Error('Address is not registered as SPO');
      }
      return this.calculateSPOVotingPower(poolId, epoch);
    }
  }

  private async queryDelegatedStake(drepId: DRepId, epoch: number): Promise<bigint> {
    const query = `
      SELECT COALESCE(SUM(amount), 0) as total_stake
      FROM delegation_vote 
      JOIN stake_address ON delegation_vote.addr_id = stake_address.id
      JOIN epoch_stake ON stake_address.id = epoch_stake.addr_id
      WHERE delegation_vote.drep_hash_id = (
        SELECT id FROM drep_hash WHERE raw = $1
      )
      AND epoch_stake.epoch_no = $2
      AND delegation_vote.tx_id IN (
        SELECT MAX(tx_id) 
        FROM delegation_vote 
        WHERE addr_id = delegation_vote.addr_id
        AND tx_id <= (
          SELECT MAX(tx.id) 
          FROM tx 
          JOIN block ON tx.block_id = block.id 
          WHERE block.epoch_no <= $2
        )
        GROUP BY addr_id
      )
    `;
    
    const result = await this.dbSyncPool.query(query, [drepId, epoch]);
    return BigInt(result.rows[0].total_stake || 0);
  }

  private async getTotalActiveStake(epoch: number): Promise<bigint> {
    const query = `
      SELECT COALESCE(SUM(amount), 0) as total_stake
      FROM epoch_stake
      WHERE epoch_no = $1
    `;
    
    const result = await this.dbSyncPool.query(query, [epoch]);
    return BigInt(result.rows[0].total_stake || 0);
  }
}
