      await expect(validateTransaction(tx)).resolves.toBe(true);
    });

    it('should calculate correct transaction fees', async () => {
      const tx = await txBuilder.buildVoteTx(
        await generateTestDRep().credential,
        await createTestGovernanceAction(),
        'no'
      );
      
      const calculatedFee = await txBuilder.calculateTxFee(tx);
      const actualFee = tx.body().fee();
      
      expect(calculatedFee.to_str()).toBe(actualFee.to_str());
    });
  });

  describe('Wallet Integration', () => {
    it('should connect to available wallets', async () => {
      const availableWallets = await walletService.detectAvailableWallets();
      expect(availableWallets.length).toBeGreaterThan(0);
      
      // Test connection to first available wallet
      const connection = await walletService.connectWallet(availableWallets[0].name);
      expect(connection.isConnected).toBe(true);
    });

    it('should sign transactions correctly', async () => {
      await walletService.connectWallet('nami'); // Use mock wallet
      const tx = await createTestTransaction();
      
      const witnessSet = await walletService.signTransaction(tx);
      
      expect(witnessSet).toBeDefined();
      await expect(verifyTransactionSignature(tx, witnessSet)).resolves.toBe(true);
    });

    it('should handle wallet disconnection gracefully', async () => {
      await walletService.connectWallet('nami');
      expect(walletService.isConnected()).toBe(true);
      
      await simulateWalletDisconnection();
      
      expect(walletService.isConnected()).toBe(false);
      await expect(walletService.signTransaction(createTestTransaction()))
        .rejects.toThrow('No wallet connected');
    });
