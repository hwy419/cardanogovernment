// Health monitoring
export class BlockchainHealthMonitor {
  async checkNodeHealth(): Promise<HealthStatus> {
    try {
      const tip = await this.cardanoNode.queryTip();
      const syncProgress = await this.cardanoNode.getSyncProgress();
      
      return {
        status: syncProgress > 99.9 ? 'healthy' : 'syncing',
        blockHeight: tip.block,
        syncProgress,
        lastUpdated: new Date().toISOString()
      };
    } catch (error) {
      return {
        status: 'unhealthy',
        error: error.message,
        lastUpdated: new Date().toISOString()
      };
    }
  }

  async checkDataSourceHealth(): Promise<DataSourceHealth> {
    const sources = ['cardano-node', 'db-sync', 'ogmios', 'blockfrost'];
    const healthChecks = await Promise.allSettled(
      sources.map(source => this.checkSourceHealth(source))
    );
    
    return {
      sources: sources.map((source, index) => ({
        name: source,
        status: healthChecks[index].status === 'fulfilled' ? 'healthy' : 'unhealthy',
        lastCheck: new Date().toISOString()
      })),
      overallHealth: healthChecks.every(check => check.status === 'fulfilled') ? 'healthy' : 'degraded'
    };
  }
}
