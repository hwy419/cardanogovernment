### Wallet Integration Service
```typescript
// Universal wallet integration with CIP-30 support
export class WalletIntegrationService {
  private connectedWallet: CardanoWalletApi | null = null;
  private walletName: string | null = null;
  private supportedWallets: string[] = [
    'nami', 'eternl', 'flint', 'yoroi', 'lace', 'typhon', 'gerowallet', 'vespr'
  ];

  async detectAvailableWallets(): Promise<AvailableWallet[]> {
    const available: AvailableWallet[] = [];
    
    for (const walletName of this.supportedWallets) {
      try {
        const walletApi = (window as any).cardano?.[walletName];
        if (walletApi) {
          const isEnabled = await walletApi.isEnabled();
          available.push({
            name: walletName,
            displayName: this.getWalletDisplayName(walletName),
            icon: await walletApi.getIcon(),
            version: await walletApi.getAPIVersion(),
            isEnabled
          });
        }
      } catch (error) {
        console.warn(`Error detecting wallet ${walletName}:`, error);
      }
    }
    
    return available;
  }

  async connectWallet(walletName: string): Promise<WalletConnection> {
    try {
      const walletApi = (window as any).cardano?.[walletName];
      if (!walletApi) {
        throw new Error(`Wallet ${walletName} not found`);
      }

      // Enable wallet connection
      const api = await walletApi.enable();
      this.connectedWallet = api;
      this.walletName = walletName;

      // Get wallet information
      const networkId = await api.getNetworkId();
      const balance = await api.getBalance();
      const usedAddresses = await api.getUsedAddresses();
      const unusedAddresses = await api.getUnusedAddresses();
      const changeAddress = await api.getChangeAddress();
      const rewardAddresses = await api.getRewardAddresses();
      const utxos = await api.getUtxos();

      // Calculate staking information
      const stakingInfo = await this.getStakingInformation(rewardAddresses[0]);

      return {
        walletName,
        networkId,
        balance: this.parseBalance(balance),
        addresses: {
          used: usedAddresses,
          unused: unusedAddresses,
          change: changeAddress,
          reward: rewardAddresses
        },
        utxos,
        stakingInfo,
        isConnected: true
      };
    } catch (error) {
      console.error(`Failed to connect to wallet ${walletName}:`, error);
      throw new WalletConnectionError(`Failed to connect: ${error.message}`);
    }
  }

  async signTransaction(tx: Transaction): Promise<TransactionWitnessSet> {
    if (!this.connectedWallet) {
      throw new Error('No wallet connected');
    }

    try {
      const witnessSet = await this.connectedWallet.signTx(
        Buffer.from(tx.to_bytes()).toString('hex'),
        true // Partial signing for multi-sig scenarios
      );
      
      return TransactionWitnessSet.from_bytes(
        Buffer.from(witnessSet, 'hex')
      );
    } catch (error) {
      console.error('Transaction signing failed:', error);
      throw new TransactionSigningError(`Signing failed: ${error.message}`);
    }
  }

  async signData(address: Address, payload: string): Promise<COSESign1> {
    if (!this.connectedWallet) {
      throw new Error('No wallet connected');
    }

    try {
      const signature = await this.connectedWallet.signData(
        Buffer.from(address.to_bytes()).toString('hex'),
        Buffer.from(payload, 'utf8').toString('hex')
      );
      
      return COSESign1.from_bytes(Buffer.from(signature.signature, 'hex'));
    } catch (error) {
      console.error('Data signing failed:', error);
      throw new DataSigningError(`Data signing failed: ${error.message}`);
    }
  }

  async submitTransaction(tx: Transaction): Promise<string> {
    if (!this.connectedWallet) {
      throw new Error('No wallet connected');
    }

    try {
      const txHash = await this.connectedWallet.submitTx(
        Buffer.from(tx.to_bytes()).toString('hex')
      );
      
      return txHash;
    } catch (error) {
      console.error('Transaction submission failed:', error);
      throw new TransactionSubmissionError(`Submission failed: ${error.message}`);
    }
  }

  async getStakingInformation(rewardAddress: Address): Promise<StakingInfo> {
    // Query staking information for the reward address
    const stakeAccount = await this.queryStakeAccount(rewardAddress);
    
    return {
      isRegistered: stakeAccount.active,
      stakePoolId: stakeAccount.pool_id,
      delegatedStake: stakeAccount.controlled_amount,
      rewards: stakeAccount.rewards_sum,
      withdrawableRewards: stakeAccount.withdrawable_amount,
      drepDelegation: stakeAccount.drep_id
    };
  }

  private parseBalance(cbor: string): WalletBalance {
    // Parse CBOR balance into structured format
    const value = Value.from_bytes(Buffer.from(cbor, 'hex'));
    const coin = value.coin();
    const multiAsset = value.multiasset();
    
    const assets: Asset[] = [];
    if (multiAsset) {
      // Parse native tokens
      const scriptHashes = multiAsset.keys();
      for (let i = 0; i < scriptHashes.len(); i++) {
        const scriptHash = scriptHashes.get(i);
        const assetNames = multiAsset.get(scriptHash);
        if (assetNames) {
          for (let j = 0; j < assetNames.keys().len(); j++) {
            const assetName = assetNames.keys().get(j);
            const amount = assetNames.get(assetName);
            if (amount) {
              assets.push({
                policyId: Buffer.from(scriptHash.to_bytes()).toString('hex'),
                assetName: Buffer.from(assetName.name()).toString('hex'),
                amount: amount.to_str()
              });
            }
          }
        }
      }
    }
    
    return {
      ada: coin.to_str(),
      assets
    };
  }
}
