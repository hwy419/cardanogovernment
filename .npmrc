# NPM configuration for Cardano Governance Platform
# Helps with React 19 compatibility during dependency resolution

# Enable legacy peer deps to handle React 19 transition period
legacy-peer-deps=true

# Set strict peer deps to false for now
strict-peer-deps=false

# Auto install peer dependencies
auto-install-peers=true

# Engine strict
engine-strict=true

# Fund messages
fund=false

# Audit level
audit-level=moderate 