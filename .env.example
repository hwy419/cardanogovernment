# Cardano Governance Platform - Environment Configuration
# Copy this file to .env.local and fill in your values

# =====================================
# Application Configuration
# =====================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# =====================================
# Cardano Network Configuration
# =====================================
NEXT_PUBLIC_CARDANO_NETWORK=mainnet
# Options: mainnet, testnet, preview, preprod

# =====================================
# API Configuration
# =====================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# =====================================
# Blockchain Data Providers
# =====================================
# Blockfrost - Primary data source
NEXT_PUBLIC_BLOCKFROST_PROJECT_ID=your_blockfrost_project_id_here
BLOCKFROST_PROJECT_ID_MAINNET=mainnet_project_id
BLOCKFROST_PROJECT_ID_TESTNET=testnet_project_id

# Koios - Alternative API
NEXT_PUBLIC_KOIOS_API_URL=https://api.koios.rest/api/v1

# Cardano DB Sync - For advanced queries
DBSYNC_CONNECTION_STRING=postgresql://user:password@localhost:5432/cexplorer

# =====================================
# Wallet Integration
# =====================================
# CIP-30 Wallet Configuration
NEXT_PUBLIC_SUPPORTED_WALLETS=nami,eternl,flint,yoroi,gerowallet,nufi,typhoncip30

# Wallet Connect (if needed for advanced features)
WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id

# =====================================
# Authentication & Security
# =====================================
# NextAuth Configuration
NEXTAUTH_SECRET=your_super_secret_jwt_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# Session Configuration
SESSION_SECRET=your_session_secret_here
SESSION_TIMEOUT=3600

# =====================================
# Database Configuration (if using external DB)
# =====================================
# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/cardano_governance

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379

# =====================================
# Cloud Storage & CDN
# =====================================
# AWS S3 (for proposal documents)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=cardano-governance-documents

# CloudFront CDN
CLOUDFRONT_DISTRIBUTION_ID=your_cloudfront_distribution_id

# =====================================
# Email & Notifications
# =====================================
# SendGrid for email notifications
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@cardano-governance.org

# Push notifications
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# =====================================
# Analytics & Monitoring
# =====================================
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry for error tracking
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# PostHog for product analytics
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# =====================================
# Feature Flags
# =====================================
# Enable/disable features
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false
NEXT_PUBLIC_ENABLE_PROPOSAL_CREATION=true
NEXT_PUBLIC_ENABLE_DREP_REGISTRATION=true
NEXT_PUBLIC_ENABLE_ADVANCED_ANALYTICS=false

# =====================================
# External Integrations
# =====================================
# IPFS for decentralized storage
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_key

# GitHub (for proposal repository integration)
GITHUB_TOKEN=your_github_token
GITHUB_REPO_OWNER=cardano-foundation
GITHUB_REPO_NAME=governance-proposals

# =====================================
# Development & Testing
# =====================================
# Test environment configuration
TEST_WALLET_MNEMONIC=your_test_wallet_mnemonic_for_automated_testing
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/cardano_governance_test

# API rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# =====================================
# Governance Configuration
# =====================================
# Voting thresholds and parameters
MIN_PROPOSAL_DEPOSIT=50000000000
VOTING_PERIOD_DAYS=30
DREP_DEPOSIT=500000000

# Constitutional Committee
CC_THRESHOLD=0.67
CC_TERM_LIMIT_EPOCHS=73

# =====================================
# Localization
# =====================================
# Supported languages
NEXT_PUBLIC_SUPPORTED_LOCALES=en,es,ja,fr,de
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Translation service (if using automated translation)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# =====================================
# Performance & Caching
# =====================================
# Cache configuration
CACHE_TTL_SECONDS=300
REDIS_CACHE_TTL=3600

# CDN configuration
CDN_BASE_URL=https://cdn.cardano-governance.org

# =====================================
# Legal & Compliance
# =====================================
# GDPR compliance
PRIVACY_POLICY_URL=https://cardano-governance.org/privacy
TERMS_OF_SERVICE_URL=https://cardano-governance.org/terms

# Cookie consent
COOKIE_CONSENT_REQUIRED=true

# =====================================
# Advanced Features
# =====================================
# AI/ML services (for proposal analysis)
OPENAI_API_KEY=your_openai_api_key

# WebSocket configuration
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=10000

# =====================================
# Mobile App Configuration
# =====================================
# Deep linking
NEXT_PUBLIC_APP_SCHEME=cardano-governance
NEXT_PUBLIC_UNIVERSAL_LINK_DOMAIN=cardano-governance.org

# Push notification certificates
IOS_PUSH_CERT_PATH=/path/to/ios/push/cert.p8
ANDROID_PUSH_KEY=your_firebase_server_key

# =====================================
# Backup & Recovery
# =====================================
# Database backup configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=cardano-governance-backups

# =====================================
# Load Balancing & Scaling
# =====================================
# Health check endpoints
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# Auto-scaling configuration
MIN_INSTANCES=2
MAX_INSTANCES=50
TARGET_CPU_UTILIZATION=70